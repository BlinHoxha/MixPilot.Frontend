VITE_API_URL=http://localhost:5290
# Explicit local-only opt-in. Requires the backend's Development identity too.
VITE_DEV_IDENTITY=true
# Production: set false and configure your OIDC provider for code + PKCE.
# VITE_OIDC_AUTHORITY=https://identity.example.com
# VITE_OIDC_CLIENT_ID=mixpilot-web
# VITE_OIDC_SCOPE=openid profile mixpilot-api
# VITE_OIDC_RESOURCE=your-backend-audience
