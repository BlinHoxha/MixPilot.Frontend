{
  "name": "mixpilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @mixpilot/web dev",
    "mobile": "pnpm --filter @mixpilot/mobile start",
    "build": "pnpm --filter @mixpilot/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages tests",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts:generate": "node scripts/contracts.mjs",
    "contracts:check": "node scripts/contracts.mjs --check",
    "check": "pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write . --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18",
    "prettier": "^3.8.1"
  }
}
